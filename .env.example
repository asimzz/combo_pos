# Database - Neon PostgreSQL
DATABASE_URL="postgresql://username:password@ep-xxxxx.region.aws.neon.tech/combo_pos?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-key-here"

# App Configuration
NEXT_PUBLIC_APP_NAME="Combo POS"
NEXT_PUBLIC_CURRENCY="USD"
NEXT_PUBLIC_TAX_RATE="0.08"
NEXT_PUBLIC_SERVICE_CHARGE="0.05"

# combo-ai-agent integration
# Bearer token the agent presents to call POST /api/orders and /api/special-orders.
COMBO_POS_API_KEY="change-me-shared-secret"
# Where the agent service is running.
AI_AGENT_BASE_URL="http://localhost:8080"
# Optional — if the agent itself is protected, send this Bearer on inbox proxy calls.
AI_AGENT_API_KEY=""